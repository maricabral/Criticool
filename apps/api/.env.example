DATABASE_URL="postgresql://criticool:criticool@localhost:5432/criticool?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
TMDB_ACCESS_TOKEN=
TMDB_DEFAULT_LANGUAGE="en-US"
TMDB_DEFAULT_REGION="US"
TRANSLATION_PROVIDER="google"
# Optional custom JSON translation endpoint. When set, the API posts:
# { fields: { quickTake, body }, sourceLocale, targetLocale }
# and expects { fields: { quickTake, body } }.
TRANSLATION_ENDPOINT_URL=
TRANSLATION_API_KEY=
PORT=3000
